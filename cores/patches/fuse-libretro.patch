+/* Index into the fuse_joypad_type value list -> libretro controller port
+   device. Keep the order in sync with core_vars[] and
+   core_option_definitions[]: none, cursor, kempston, sinclair 1, sinclair 2,
+   timex 1, timex 2, fuller. */
+static unsigned joystick_device_from_option(int option)
+{
+   switch (option)
+   {
+      case 0:  return RETRO_DEVICE_NONE;
+      case 1:  return RETRO_DEVICE_CURSOR_JOYSTICK;
+      case 2:  return RETRO_DEVICE_KEMPSTON_JOYSTICK;
+      case 3:  return RETRO_DEVICE_SINCLAIR1_JOYSTICK;
+      case 4:  return RETRO_DEVICE_SINCLAIR2_JOYSTICK;
+      case 5:  return RETRO_DEVICE_TIMEX1_JOYSTICK;
+      case 6:  return RETRO_DEVICE_TIMEX2_JOYSTICK;
+      case 7:  return RETRO_DEVICE_FULLER_JOYSTICK;
+   }
+
+   /* Unreadable or invalid option: keep the Kempston default. */
+   return RETRO_DEVICE_KEMPSTON_JOYSTICK;
+}
