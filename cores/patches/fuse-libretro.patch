+   /* Joystick on port 1. Frontends such as minarch never expose controller
+      port device types, so without this option no port is ever configured as
+      a joystick and compat/ui.c ignores the pad entirely. Applied here (and
+      not only in retro_set_controller_port_device) so that a running game
+      picks up a change made in the Options menu. */
+   {
+      int option = coreopt(env_cb, core_vars, "fuse_joypad_type", NULL);
+      unsigned device = joystick_device_from_option(option);
