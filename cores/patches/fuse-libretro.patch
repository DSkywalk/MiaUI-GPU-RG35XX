diff --git a/Makefile.libretro b/Makefile.libretro
index f5afa42..bf23ca9 100644
--- a/Makefile.libretro
+++ b/Makefile.libretro
@@ -197,6 +197,30 @@ else ifeq ($(platform), classic_armv8_a35)
 	LDFLAGS += -marm -mcpu=cortex-a35 -mfpu=neon-fp-armv8 -mfloat-abi=hard -Ofast -flto -fuse-linker-plugin
 #######################################
 
+# RG35XX
+else ifeq ($(platform), rg35xx)
+	TARGET := $(TARGET_NAME)_libretro.so
+	CC = $(CROSS_COMPILE)gcc
+	CXX = $(CROSS_COMPILE)g++
+	AR = $(CROSS_COMPILE)ar
+	SHARED := -shared -Wl,--version-script=build/link.T -Wl,--no-undefined
+
+	CFLAGS += -Ofast \
+	-marm -mcpu=cortex-a9 -mfpu=neon-fp16 -mfloat-abi=hard \
+	-flto=4 -fwhole-program -fuse-linker-plugin \
+	-fdata-sections -ffunction-sections -Wl,--gc-sections \
+	-fno-stack-protector -fno-ident -fomit-frame-pointer \
+	-fno-unwind-tables -fno-asynchronous-unwind-tables \
+	-fmerge-all-constants -fno-math-errno
+
+	CXXFLAGS += $(CFLAGS)
+	CPPFLAGS += $(CFLAGS)
+	ASFLAGS += $(CFLAGS)
+	HAVE_NEON = 1
+	ARCH = arm
+	LDFLAGS += -lrt
+	LDFLAGS += -marm -mcpu=cortex-a9 -mfpu=neon-fp16 -mfloat-abi=hard -Ofast -flto=4 -fuse-linker-plugin -fPIC
+
 # OS X
 else ifeq ($(platform), osx)
 	TARGET := $(TARGET_NAME)_libretro.dylib
