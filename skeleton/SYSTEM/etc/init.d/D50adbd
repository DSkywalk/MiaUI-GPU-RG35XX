#!/bin/sh
#
# Start adb daemon service....
#

echo "starting adb..."

# The USB port is usbnet.sh's to set up: one way for ADB and the USB network
# alike. This stays as the old entry point, and does it the old way only if
# usbnet.sh isn't there.
USBNET=/usr/sbin/usbnet.sh
if [ "$1" != host ] && [ -f "$USBNET" ]; then
	exec sh "$USBNET" adb
fi
 
echo "------usbdbg $1"

# shutdown usb monitor
killall -9 adbd
rmmod ethernet
echo 0 > /sys/monitor/usb_port/config/run

if [ $1 = host ];then
        # device -> host
    echo 0 > /sys/monitor/usb_port/config/idpin_debug
        /usr/sbin/usbmond.sh USB_B_OUT && /usr/sbin/usbmond.sh USB_A_IN
else
        # host -> device
    echo 1 > /sys/monitor/usb_port/config/idpin_debug
        /usr/sbin/usbmond.sh USB_A_OUT && /usr/sbin/usbmond.sh USB_B_IN
fi

